      "files": [{ "rel": "src/stats.js", "text": "// 点数の一覧から平均と最大を返す\nfunction summarize(scores) {\n  let total = 0;\n  for (let i = 0; i <= scores.length; i++) {\n    total += scores[i];\n  }\n  const max = Math.max(...scores);\n  return { avg: total / scores.length, max };\n}\n\nfunction load(path) {\n  try {\n    return JSON.parse(require('fs').readFileSync(path, 'utf8'));\n  } catch (e) {\n    return [];\n  }\n}\nmodule.exports = { summarize, load };\n" }],
      "expectChecks": ["persona", "checklist", "counterexample", "verify", "canary", "quotes", "coverage"],
      "expectGroups": [],
